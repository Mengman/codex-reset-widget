<Window x:Class="CodexResetWidget.Presentation.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.About.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="{StaticResource AppLogo}"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI">
  <StackPanel Margin="22">
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="{StaticResource AppLogo}" Width="48" Height="48" HorizontalAlignment="Left"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Codex Reset" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel>
    </Grid>
    <TextBlock Text="{DynamicResource Text.About.Subtitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="{DynamicResource Text.About.Description}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,12">
      <StackPanel>
        <Button Content="GitHub · Mengman ↗" Click="OpenGitHub" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Padding="0" MinHeight="28" AutomationProperties.Name="{DynamicResource Text.About.GitHubAccessible}" ToolTip="https://github.com/Mengman"/>
        <Button Content="{DynamicResource Text.About.Source}" Click="OpenSource" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Padding="0" MinHeight="28" AutomationProperties.Name="{DynamicResource Text.About.SourceAccessible}" ToolTip="https://codex-resets.com/"/>
        <TextBlock Text="{DynamicResource Text.About.License}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock Text="{DynamicResource Text.About.Disclaimer}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,0,0,12"/>
    <Button Content="{DynamicResource Text.About.Close}" IsCancel="True" MinWidth="72" HorizontalAlignment="Right" Padding="14,5" AutomationProperties.Name="{DynamicResource Text.About.CloseAccessible}"/>
  </StackPanel>
</Window>
