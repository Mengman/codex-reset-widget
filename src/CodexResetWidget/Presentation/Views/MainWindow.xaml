<Window x:Class="CodexResetWidget.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex Reset" Width="400" Height="840" MinWidth="370" MinHeight="260"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="{StaticResource AppLogo}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Topmost="{Binding IsPinned}">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11,7,11,7" CornerRadius="10">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource AppLogo}" Width="26" Height="26" Margin="0,0,8,0" />
          <TextBlock Text="Codex Reset" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Content="refresh" Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Text.Action.RefreshTooltip}" AutomationProperties.Name="{DynamicResource Text.Action.Refresh}" />
          <Button x:Name="PinButton" Command="{Binding TogglePinCommand}" AutomationProperties.Name="{DynamicResource Text.Action.PinToggle}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Content" Value="pin"/><Setter Property="ToolTip" Value="{DynamicResource Text.Action.Pin}"/><Style.Triggers>
              <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Content" Value="pinned" /><Setter Property="ToolTip" Value="{DynamicResource Text.Action.Unpin}" /><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
            </Style.Triggers></Style></Button.Style>
          </Button>
          <Button Style="{StaticResource ModeButton}" Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeAction}" AutomationProperties.Name="{DynamicResource Text.Action.ModeToggle}" />
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="more" Click="ShowMenu" ToolTip="{DynamicResource Text.Action.MoreTooltip}" AutomationProperties.Name="{DynamicResource Text.Action.More}">
            <Button.ContextMenu>
              <ContextMenu Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}">
                <MenuItem Header="{DynamicResource Text.Theme.System}" Tag="System" Click="SelectTheme" />
                <MenuItem Header="{DynamicResource Text.Theme.Light}" Tag="Light" Click="SelectTheme" />
                <MenuItem Header="{DynamicResource Text.Theme.Dark}" Tag="Dark" Click="SelectTheme" />
                <MenuItem x:Name="LanguageMenuItem" Header="{DynamicResource Text.Language.Menu}">
                  <MenuItem x:Name="SystemLanguageItem" Header="{DynamicResource Text.Language.System}" Tag="System" IsCheckable="True" Click="SelectLanguage" />
                  <MenuItem x:Name="EnglishLanguageItem" Header="{DynamicResource Text.Language.English}" Tag="English" IsCheckable="True" Click="SelectLanguage" />
                  <MenuItem x:Name="ChineseLanguageItem" Header="{DynamicResource Text.Language.Chinese}" Tag="SimplifiedChinese" IsCheckable="True" Click="SelectLanguage" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource Text.About.Title}" Click="ShowAbout"/>
                <MenuItem Header="{DynamicResource Text.Source.Menu}" Click="OpenSource" />
                <Separator />
                <MenuItem Header="{DynamicResource Text.Action.Minimize}" Click="MinimizeWindow" />
                <MenuItem Header="{DynamicResource Text.Action.Hide}" Click="HideWindow" />
                <MenuItem Header="{DynamicResource Text.Action.Exit}" Click="ExitWindow" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource IconButton}" Content="close" Click="CloseWindow" ToolTip="{DynamicResource Text.Action.CloseTooltip}" AutomationProperties.Name="{DynamicResource Text.Action.CloseWindow}" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,0,0">
          <Border x:Name="CountdownCard" Style="{StaticResource Card}" Height="200" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="20"/></Grid.RowDefinitions>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Board.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="9,4" VerticalAlignment="Top"><TextBlock Text="{Binding Board.Badge}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border>
              </Grid>
              <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" Visibility="{Binding Board.HasCountdown, Converter={StaticResource BoolVisibility}}">
                  <Viewbox Height="55" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding Board.Countdown}" FontSize="48" LineHeight="52" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource AccentBrush}"/></Viewbox>
                  <TextBlock Text="{DynamicResource Text.Board.RemainingLabel}" Style="{StaticResource SecondaryText}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,13"/>
                  <TextBlock Text="{DynamicResource Text.Board.ExpectedLabel}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding Board.MainDate}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" ToolTip="{Binding Board.ZoneName}"/>
                </StackPanel>
                <TextBlock Text="{Binding Board.MainDate}" Visibility="{Binding Board.ShowsDate, Converter={StaticResource BoolVisibility}}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" ToolTip="{Binding Board.ZoneName}"/>
                <TextBlock Text="{Binding Board.EmptyText}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Board.HasCountdown}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Board.ShowsDate}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Board.Supporting}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource Text.Board.QuotaDisclaimer}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Bottom"/>
              </Grid>
            </Grid>
          </Border>
          <Border Background="{DynamicResource NoticeBrush}" CornerRadius="5" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding Board.HasNotice, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Board.Notice}" Foreground="{DynamicResource NoticeTextBrush}" FontSize="11" TextWrapping="Wrap"/></Border>
          <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="0,8,0,2">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="left" Command="{Binding OlderAnnouncementCommand}" ToolTip="{DynamicResource Text.Announcement.OlderTooltip}" AutomationProperties.Name="{DynamicResource Text.Announcement.OlderAccessible}" />
                <Button Style="{StaticResource IconButton}" Content="right" Command="{Binding NewerAnnouncementCommand}" ToolTip="{DynamicResource Text.Announcement.NewerTooltip}" AutomationProperties.Name="{DynamicResource Text.Announcement.NewerAccessible}" />
              </StackPanel>
              <TextBlock x:Name="AnnouncementHeading" Text="{Binding Announcement.Heading}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border x:Name="AnnouncementCard" Style="{StaticResource Card}" Height="190">
              <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource AvatarBrush}" Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Left"><TextBlock Text="{Binding Announcement.Avatar}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding Announcement.Author}" FontWeight="SemiBold"/><TextBlock Text="{Binding Announcement.Handle}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Announcement.SourceBadge}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer x:Name="AnnouncementScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,8"><TextBlock Text="{Binding Announcement.Text}" TextWrapping="Wrap" FontSize="14" LineHeight="21"/></ScrollViewer>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Announcement.Published}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding Announcement.ZoneLabel}"/>
                  <Button Grid.Column="1" Content="{DynamicResource Text.Announcement.ViewOriginal}" Click="OpenAnnouncement" Visibility="{Binding Announcement.HasLink, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Padding="0" MinHeight="22" AutomationProperties.Name="{DynamicResource Text.Announcement.ViewOriginalAccessible}"/>
                </Grid>
              </Grid>
            </Border>
            <Grid Height="28" Margin="0,8,0,2"><TextBlock x:Name="CalendarHeading" Text="{DynamicResource Text.Calendar.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
            <TextBlock Text="{Binding HistoryNotice}" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasHistoryNotice, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,5"/>
            <Border x:Name="CalendarCard" Style="{StaticResource Card}" Height="284" Padding="12">
              <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="22"/><RowDefinition/><RowDefinition Height="22"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Calendar.MonthLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource Text.Calendar.ThisMonth}" Command="{Binding TodayCommand}" Padding="4,0" FontSize="11" MinHeight="28" AutomationProperties.Name="{DynamicResource Text.Calendar.ReturnThisMonth}"/><Button Style="{StaticResource IconButton}" Content="left" Command="{Binding PreviousMonthCommand}" ToolTip="{DynamicResource Text.Calendar.PreviousMonth}" AutomationProperties.Name="{DynamicResource Text.Calendar.PreviousMonth}"/><Button Style="{StaticResource IconButton}" Content="right" Command="{Binding NextMonthCommand}" ToolTip="{DynamicResource Text.Calendar.NextMonth}" AutomationProperties.Name="{DynamicResource Text.Calendar.NextMonth}"/></StackPanel>
                </Grid>
                <UniformGrid Grid.Row="1" Columns="7" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.Week.Monday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Tuesday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Wednesday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Thursday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Friday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Saturday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/><TextBlock Text="{DynamicResource Text.Week.Sunday}" TextAlignment="Center" Style="{StaticResource SecondaryText}"/></UniformGrid>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.Days}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource DayButton}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel>
                        <TextBlock Text="{Binding Number}" FontSize="12" LineHeight="14" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="8">
                          <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasRegular, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="◆" FontSize="9" Foreground="{DynamicResource BankedBrush}" Visibility="{Binding HasBanked, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="○" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Visibility="{Binding HasUnknown, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="◇" FontSize="10" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasForecast, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="{Binding Count}" FontSize="9" Margin="2,0,0,0" Visibility="{Binding HasMultiple, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Grid.Row="3" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.Calendar.RegularLegend}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource Text.Calendar.BankedLegend}" FontSize="10" Foreground="{DynamicResource BankedBrush}" ToolTip="{DynamicResource Text.Calendar.BankedTooltip}"/><TextBlock Text="{DynamicResource Text.Calendar.ForecastLegend}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></WrapPanel>
                <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,3,0,0">
                  <Grid><TextBlock Text="{Binding Calendar.EmptyText}" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers><DataTrigger Binding="{Binding Calendar.HasEvents}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Calendar.Events}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" MinHeight="24" HorizontalContentAlignment="Stretch" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Label}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="›" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Content="{Binding SourceCaption}" Click="OpenSource" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Padding="0" MinHeight="22" HorizontalAlignment="Left" ToolTip="{DynamicResource Text.Source.Tooltip}" />
          <TextBlock Grid.Column="1" Text="{Binding FooterTime}" ToolTip="{Binding UpstreamTime}" Style="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding CacheWarning}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource NoticeTextBrush}" FontSize="11" TextWrapping="Wrap" />
        <TextBlock x:Name="DesktopNotice" Style="{StaticResource OptionalText}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
