<Window x:Class="CodexResetWidget.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Codex Reset" Width="440" Height="1020" MinWidth="370" MinHeight="260"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="{StaticResource AppLogo}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Topmost="{Binding IsPinned}">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8,12,8" CornerRadius="10">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource AppLogo}" Width="29" Height="29" Margin="0,0,10,0" />
          <TextBlock Text="Codex Reset" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="刷新公告与历史记录" AutomationProperties.Name="刷新数据" />
          <Button x:Name="PinButton" Content="&#xE718;" Command="{Binding TogglePinCommand}" ToolTip="切换窗口置顶" AutomationProperties.Name="切换置顶">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers>
              <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
            </Style.Triggers></Style></Button.Style>
          </Button>
          <Button Style="{StaticResource ModeButton}" Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeAction}" AutomationProperties.Name="切换窗口模式" />
          <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化窗口" />
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="ShowMenu" ToolTip="主题、演示工具与退出" AutomationProperties.Name="更多菜单">
            <Button.ContextMenu>
              <ContextMenu Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}">
                <MenuItem Header="跟随系统主题" Tag="System" Click="SelectTheme" />
                <MenuItem Header="浅色主题" Tag="Light" Click="SelectTheme" />
                <MenuItem Header="深色主题" Tag="Dark" Click="SelectTheme" />
                <Separator />
                <MenuItem Header="打开独立演示窗口" Click="OpenDemo" />
                <MenuItem Header="显示／隐藏演示工具" Click="ToggleTools" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" />
                <MenuItem Header="运行界面检查并导出快照" Click="RunPrototypeChecks" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" />
                <MenuItem Header="数据来源：Codex Resets" Click="OpenSource" />
                <Separator />
                <MenuItem Header="最小化" Click="MinimizeWindow" />
                <MenuItem Header="收进托盘" Click="HideWindow" />
                <MenuItem Header="退出" Click="ExitWindow" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseWindow" ToolTip="关闭窗口，正式模式收进托盘" AutomationProperties.Name="关闭窗口" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,0,0,8">

        <Grid Margin="0,7,0,0" Visibility="{Binding ToolsOpen, Converter={StaticResource BoolVisibility}}">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Label" AutomationProperties.Name="演示场景" ToolTip="模拟场景，不请求真实接口" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone}" DisplayMemberPath="Label" AutomationProperties.Name="显示时区" ToolTip="演示时区不会修改电脑设置" />
        </Grid>
      </StackPanel>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,0,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Board.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="28,0,8,0" />
                <TextBlock Text="&#xE917;" FontFamily="Segoe Fluent Icons" FontSize="20" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="14" Padding="12,5" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Board.Badge}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                </Border>
              </Grid>
              <StackPanel Margin="0,10,0,0" Visibility="{Binding Board.HasCountdown, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Board.Countdown}" FontFamily="Segoe UI Variable, Segoe UI" FontWeight="Bold" Typography.NumeralAlignment="Tabular" FontSize="56" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="距公告预计时间" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,0,0,5" FontSize="11" />
                <TextBlock Text="{Binding Board.MainDate}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Board.MainDate}" Visibility="{Binding Board.ShowsDate, Converter={StaticResource BoolVisibility}}" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,23,0,16" />
              <TextBlock Text="{Binding Board.EmptyText}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,23,0,16">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Board.HasCountdown}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Board.ShowsDate}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Board.Summary}" Style="{StaticResource SecondaryText}" ToolTip="{Binding Board.ZoneName}" HorizontalAlignment="Center" Margin="0,6,0,0" />

              <Border Background="{DynamicResource NoticeBrush}" CornerRadius="5" Padding="10,8" Margin="0,12,0,0" Visibility="{Binding Board.HasNotice, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding Board.Notice}" Foreground="{DynamicResource NoticeTextBrush}" FontSize="12" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
          <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="2,14,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding OlderAnnouncementCommand}" ToolTip="较早的公告" AutomationProperties.Name="阅读较早公告" />
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NewerAnnouncementCommand}" ToolTip="较新的公告" AutomationProperties.Name="阅读较新公告" />
              </StackPanel>
              <Button DockPanel.Dock="Right" Content="返回最新" Command="{Binding ReturnLatestCommand}" Visibility="{Binding Announcement.IsReadingHistory, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" Padding="5,0" MinHeight="26" AutomationProperties.Name="返回最新公告" />
              <TextBlock Text="{Binding Announcement.Heading}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource AvatarBrush}" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Announcement.Avatar}" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding Announcement.Author}" FontWeight="SemiBold" /><TextBlock Text="{Binding Announcement.Handle}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Announcement.SourceBadge}" Style="{StaticResource SecondaryText}" />
                </Grid>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,10,0,12">
                  <TextBlock Text="{Binding Announcement.Text}" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                </ScrollViewer>
                <TextBlock Text="{Binding Announcement.Published}" Style="{StaticResource SecondaryText}" ToolTip="{Binding Announcement.ZoneLabel}" />
                <Button Content="查看原文 ↗" Click="OpenAnnouncement" Visibility="{Binding Announcement.HasLink, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Padding="0" MinHeight="24" HorizontalAlignment="Right" AutomationProperties.Name="查看公告原文" />


              </StackPanel>
            </Border>
            <TextBlock Text="重置日历" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding HistoryHealthText}" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,5" />
            <Border Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <Grid Margin="2,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="20" VerticalAlignment="Center" />
                  <TextBlock Margin="28,0,0,0" Text="{Binding Calendar.MonthLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="本月" Command="{Binding TodayCommand}" Padding="6,0" FontSize="11" AutomationProperties.Name="返回本月" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Command="{Binding PreviousMonthCommand}" ToolTip="上个月" AutomationProperties.Name="上个月" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Command="{Binding NextMonthCommand}" ToolTip="下个月" AutomationProperties.Name="下个月" />
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="7" Margin="0,0,0,5">
                  <TextBlock Text="一" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="二" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="三" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="四" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="五" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="六" TextAlignment="Center" Style="{StaticResource SecondaryText}" /><TextBlock Text="日" TextAlignment="Center" Style="{StaticResource SecondaryText}" />
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding Calendar.Days}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource DayButton}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding AccessibleName}">
                      <StackPanel>
                        <TextBlock Text="{Binding Number}" FontSize="13" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="12">
                          <TextBlock Text="●" FontSize="9" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasRegular, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="◆" FontSize="9" Foreground="{DynamicResource BankedBrush}" Visibility="{Binding HasBanked, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="○" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" Visibility="{Binding HasUnknown, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="◇" FontSize="10" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasForecast, Converter={StaticResource BoolVisibility}}" />
                          <TextBlock Text="{Binding Count}" FontSize="9" Margin="2,0,0,0" Visibility="{Binding HasMultiple, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="2,9,0,0">
                  <TextBlock Text="● 全局  " FontSize="11" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="◆ 备用  " FontSize="11" Foreground="{DynamicResource BankedBrush}" /><TextBlock Text="◇ 预告  " FontSize="11" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="○ 其他／观察" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" />
                </WrapPanel>
                <TextBlock Text="按公告／观察日期归档" Style="{StaticResource SecondaryText}" Margin="2,4,0,8" FontSize="11" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="2,10,2,0">
                  <StackPanel>
                    <TextBlock Text="{Binding Calendar.SelectedLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Calendar.EmptyText}">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Style.Triggers><DataTrigger Binding="{Binding Calendar.HasEvents}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Calendar.Events}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding DataContext.SelectEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0,5" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /><ColumnDefinition Width="15" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Marker}" VerticalAlignment="Center">
                              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Marker}" Value="◆"><Setter Property="Foreground" Value="{DynamicResource BankedBrush}" /></DataTrigger><DataTrigger Binding="{Binding Marker}" Value="○"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontSize="12" /><TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" FontSize="11" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Margin="2,8,2,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Content="↗  数据来自 Codex Resets" Click="OpenSource" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Padding="0" MinHeight="22" HorizontalAlignment="Left" ToolTip="打开第三方数据来源" />
          <TextBlock Grid.Column="1" Text="{Binding FooterTime}" ToolTip="{Binding UpstreamTime}" Style="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />
        </Grid>
        <DockPanel LastChildFill="False">
          <TextBlock Text="{Binding DemoLabel}" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="演示工具" Command="{Binding ToggleToolsCommand}" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" Padding="0" MinHeight="20" FontSize="10" />
        </DockPanel>
        <TextBlock Text="{Binding CacheWarning}" Foreground="{DynamicResource NoticeTextBrush}" FontSize="11" TextWrapping="Wrap" />
        <TextBlock x:Name="DesktopNotice" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

